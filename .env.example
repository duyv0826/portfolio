# ---------------------------------------------------------------------------
# 洪兄作品集全站 — 环境变量样例
# 复制为 .env.local 后再填真实值。凭证绝不入库、绝不打印到会话或日志。
# ---------------------------------------------------------------------------

# 数据库连接（PostgreSQL 16）。
# 留空或缺失时，应用自动回退到内存 Mock 数据源，本地 `npm run dev` 无需数据库即可浏览全站。
# Prisma 7 走 @prisma/adapter-pg，连接串需含 schema 参数以避免 search_path 歧义。
DATABASE_URL=""

# 管理员 JWT 签名密钥（服务端专用，绝不暴露为 NEXT_PUBLIC_*）。
# 生成方式：openssl rand -base64 48
AUTH_SECRET=""

# 首个管理员账号。
# 有 DATABASE_URL 时走 users 表（用 `prisma db seed` 写入 ADMIN_EMAIL / ADMIN_PASSWORD）。
# 无数据库（本地演示）时比对下面的邮箱 + 口令哈希。
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# 口令哈希生成方式（明文不入库、不打印）：npm run hash-password
ADMIN_PASSWORD_HASH=""

# 站点对外地址，用于 sitemap / robots / OG 绝对路径。
NEXT_PUBLIC_SITE_URL="https://example.com"

# 腾讯云 COS（图床）—— 密钥仅做存在性使用，禁止打印
# COS_BUCKET=""
# COS_REGION=""
# COS_SECRET_ID=""
# COS_SECRET_KEY=""
