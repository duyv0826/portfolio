{
  "meta": {
    "product": "洪兄个人作品集全站",
    "version": "phase2",
    "theme": "Gallery Paper (light default) + Gallery Stage (dark, works detail only)",
    "stack": "Next.js 16 / Tailwind CSS v4 @theme / Lucide React",
    "axes": { "DESIGN_VARIANCE": 6, "MOTION_INTENSITY": 4, "VISUAL_DENSITY": 4 },
    "register": { "public": "Brand", "admin": "Product" },
    "note": "唯一允许的字面色值：#FFFFFF / #000000（仅作 accent-on 与特殊描边）。所有阴影/焦点环经 color-mix 派生自令牌，零硬编码色。配色纪律：中性色 70–90%，强调色 ≤10% 且每屏 ≤2 处可见使用。"
  },
  "color": {
    "bg":            { "value": "#FCFCFD", "type": "color", "role": "A1 页面背景（近白中性，非奶油）" },
    "surface":       { "value": "#FFFFFF", "type": "color", "role": "A1 卡片/容器" },
    "surface-warm":  { "value": "#F4F4F5", "type": "color", "role": "A2 三级表面/分区块" },
    "fg":            { "value": "#18181B", "type": "color", "role": "A1 主文本（近黑墨色）" },
    "fg-2":          { "value": "#3F3F46", "type": "color", "role": "B 次级文本" },
    "muted":         { "value": "#71717A", "type": "color", "role": "A1 辅助文本" },
    "meta":          { "value": "#A1A1AA", "type": "color", "role": "B 元数据/三级前景" },
    "border":        { "value": "#E4E4E7", "type": "color", "role": "A1 默认边框" },
    "border-soft":   { "value": "#F4F4F5", "type": "color", "role": "B 内部行分隔" },
    "accent":        { "value": "#2B4ACB", "type": "color", "role": "A1 品牌主色（深钴蓝，非 indigo-500、非紫粉）" },
    "accent-hover":  { "value": "#213AA6", "type": "color", "role": "A2 主色悬停" },
    "accent-active": { "value": "#1A2F85", "type": "color", "role": "A2 主色激活" },
    "accent-on":     { "value": "#FFFFFF", "type": "color", "role": "A1 accent 上前景（唯一允许字面白）" },
    "success":       { "value": "#16A34A", "type": "color", "role": "A2 成功/已发布" },
    "warn":          { "value": "#D97706", "type": "color", "role": "A2 警告/草稿待审" },
    "danger":        { "value": "#DC2626", "type": "color", "role": "A2 错误/删除" },
    "stage":         { "value": "#0B0B0C", "type": "color", "role": "C 作品详情暗展台背景（仅局部，非全站暗主题）" },
    "stage-fg":      { "value": "#F4F4F5", "type": "color", "role": "C 展台前景/说明文字" }
  },
  "spacing": {
    "1":  { "value": "4px",  "type": "dimension", "role": "微间距：图标与文字" },
    "2":  { "value": "8px",  "type": "dimension", "role": "紧凑间距：同一组元素" },
    "3":  { "value": "12px", "type": "dimension", "role": "标准间距：表单元素" },
    "4":  { "value": "16px", "type": "dimension", "role": "舒适间距：卡片内边距" },
    "5":  { "value": "20px", "type": "dimension", "role": "宽松间距：模块间距" },
    "6":  { "value": "24px", "type": "dimension", "role": "区块间距 / 栅格 gap" },
    "8":  { "value": "32px", "type": "dimension", "role": "大区块间距" },
    "10": { "value": "40px", "type": "dimension", "role": "页面级间距" },
    "12": { "value": "48px", "type": "dimension", "role": "最大区块间距" },
    "16": { "value": "64px", "type": "dimension", "role": "节区节奏（桌面）" },
    "20": { "value": "80px", "type": "dimension", "role": "Hero / 超大留白" }
  },
  "radius": {
    "sm":   { "value": "6px",    "type": "dimension", "role": "小元素：Badge、Tag、Input" },
    "md":   { "value": "10px",   "type": "dimension", "role": "标准元素：按钮、卡片" },
    "lg":   { "value": "14px",   "type": "dimension", "role": "大元素：弹窗、大卡片" },
    "pill": { "value": "9999px", "type": "dimension", "role": "头像、胶囊标签、圆按钮" }
  },
  "typography": {
    "font-display": { "value": "\"Bricolage Grotesque\", \"Noto Sans SC\", sans-serif", "type": "fontFamily", "role": "A1 标题（有性格的编辑感无衬线）" },
    "font-body":    { "value": "\"Inter\", \"Noto Sans SC\", sans-serif", "type": "fontFamily", "role": "A1 正文（干净专业）" },
    "font-mono":    { "value": "\"JetBrains Mono\", \"Noto Sans SC\", monospace", "type": "fontFamily", "role": "A1 元数据/标签/角色/工具/年份" },
    "font-size": {
      "xs":   { "value": "0.75rem", "type": "dimension", "px": 12, "role": "标签/徽章" },
      "sm":   { "value": "0.875rem", "type": "dimension", "px": 14, "role": "辅助文字、按钮" },
      "base": { "value": "1rem", "type": "dimension", "px": 16, "role": "正文基准" },
      "lg":   { "value": "1.125rem", "type": "dimension", "px": 18, "role": "三级标题" },
      "xl":   { "value": "1.25rem", "type": "dimension", "px": 20, "role": "二级标题" },
      "2xl":  { "value": "1.5rem", "type": "dimension", "px": 24, "role": "一级标题" },
      "3xl":  { "value": "2rem", "type": "dimension", "px": 32, "role": "Hero 副标题" },
      "4xl":  { "value": "2.5rem", "type": "dimension", "px": 40, "role": "Hero 主标题" }
    },
    "font-weight": {
      "read":      { "value": "400", "type": "fontWeight", "role": "正文、描述" },
      "emphasize": { "value": "510", "type": "fontWeight", "role": "小标题、按钮文字、表头" },
      "announce":  { "value": "590", "type": "fontWeight", "role": "大标题、CTA" }
    },
    "line-height": {
      "tight":   { "value": "1.15", "type": "number", "role": "Hero/大标题" },
      "snug":    { "value": "1.3",  "type": "number", "role": "中标题" },
      "normal":  { "value": "1.6",  "type": "number", "role": "西文正文" },
      "relaxed": { "value": "1.7",  "type": "number", "role": "中文正文" }
    },
    "letter-spacing": {
      "caps":    { "value": "0.08em", "type": "dimension", "role": "ALL CAPS / 小标签（≥0.06em）" },
      "display": { "value": "-0.02em", "type": "dimension", "role": "标题负字距" },
      "tight":   { "value": "-0.01em", "type": "dimension", "role": "次标题负字距" },
      "normal":  { "value": "0", "type": "dimension", "role": "正文 0" }
    }
  },
  "shadow": {
    "flat":   { "value": "none", "type": "shadow", "role": "默认（卡片无阴影，靠边框分层）" },
    "ring":   { "value": "0 0 0 1px var(--color-border)", "type": "shadow", "role": "内联边框环（替代外阴影分层）" },
    "raised": { "value": "0 1px 2px color-mix(in srgb, var(--color-fg) 4%, transparent), 0 4px 12px color-mix(in srgb, var(--color-fg) 6%, transparent)", "type": "shadow", "role": "悬浮抬升（blur ≤12px，避免幽灵卡片）" },
    "focus":  { "value": "0 0 0 3px color-mix(in srgb, var(--color-accent) 30%, transparent)", "type": "shadow", "role": "键盘焦点环（accent 派生）" }
  },
  "motion": {
    "fast":         { "value": "150ms", "type": "duration", "role": "确认操作/状态切换基准收敛值" },
    "base":         { "value": "200ms", "type": "duration", "role": "内容进入" },
    "slow":         { "value": "300ms", "type": "duration", "role": "滚动淡入上限" },
    "ease-standard":{ "value": "cubic-bezier(0.2, 0, 0, 1)", "type": "cubicBezier", "role": "统一缓动（禁弹跳）" }
  }
}
